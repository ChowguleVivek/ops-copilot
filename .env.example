# Copy this file to .env and adjust if needed.
# No API key required -- the LLM runs locally via Ollama.

# Must match a model you've pulled with `ollama pull <name>`.
# llama3.1 needs ~8GB RAM free; use "mistral" or "phi3" on lighter laptops.
OLLAMA_MODEL=llama3.1

# Ollama's local server address (default is fine unless you changed it).
OLLAMA_BASE_URL=http://localhost:11434

# Path to the local JSON "task board" the MCP server reads/writes.
TASK_STORE_PATH=./data/tasks.json

# Where the mock Slack notify server appends posted messages.
NOTIFY_LOG_PATH=./data/slack_log.json

# Where Chroma persists the vector index for the RAG knowledge base
CHROMA_PERSIST_DIR=./data/chroma_store
